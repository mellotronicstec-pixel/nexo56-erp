# =============================================================================
# Nexo56 ERP — exemplo de configuracao de ambiente
# Copie para .env.local (desenvolvimento) e preencha com valores REAIS.
# NUNCA versione o arquivo .env real. NUNCA coloque segredo verdadeiro aqui.
# =============================================================================

# NODE_ENV nao deve ser definido aqui: o Next o define automaticamente
# (development em `next dev`, production em `next build`/`next start`) e um
# valor fixo no .env quebra o build. Os scripts CLI assumem development.

# URL publica da aplicacao (usada em cookies, links e validacao de origem)
APP_URL=http://localhost:3000

# Conexao MariaDB/MySQL.
# Formato: mysql://usuario:senha@host:porta/banco
DATABASE_URL=mysql://usuario:senha@localhost:3306/nexo56_dev

# Banco usado pelos testes automatizados. DEVE ser diferente de DATABASE_URL
# e NUNCA pode apontar para producao (os testes truncam tabelas).
TEST_DATABASE_URL=mysql://usuario:senha@localhost:3306/nexo56_test

# Segredo de sessao. Gere com: openssl rand -base64 48
# Minimo de 32 caracteres. Valores de desenvolvimento sao recusados em producao.
SESSION_SECRET=troque-este-valor-por-um-segredo-gerado-com-openssl-rand

# Segredo usado pelo executor de jobs em background.
# Gere com: openssl rand -base64 48
JOB_SECRET=troque-este-valor-por-um-segredo-gerado-com-openssl-rand

# Duracao da sessao em horas (opcional, padrao 12)
SESSION_TTL_HOURS=12

# Nivel de log: debug | info | warn | error (opcional, padrao info)
LOG_LEVEL=info
